                "message": "src/kernel is the toolbox: it must not import src/sources or src/serve."
              },
              {
                "regex": "(^|/)infra(/|$)",
                "message": "src/kernel must not import infra."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/sources/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "effect/http",
                  "effect/http/**",
                  "effect/unstable/http",
                  "effect/unstable/http/**",
                  "**/HttpClient",
                  "**/FetchHttpClient"
                ],
                "message": "Only src/kernel/http may touch HTTP clients; go through the kernel Http service."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "node:sqlite",
                  "bun:sqlite",
                  "drizzle-orm/pglite",
                  "drizzle-orm/node-postgres",
                  "drizzle-orm/postgres-js",
                  "drizzle-orm/better-sqlite3",
                  "drizzle-orm/libsql",
                  "drizzle-orm/libsql/**",
                  "drizzle-orm/bun-sqlite",
                  "drizzle-orm/bun-sql",
                  "drizzle-orm/sql-js",
                  "drizzle-orm/effect-*",
                  "@electric-sql/*",
                  "@effect/sql-*",
                  "effect/sql",
                  "effect/sql/**",
                  "effect/unstable/sql",
                  "effect/unstable/sql/**"
                ],
                "message": "No SQL drivers: tabular data goes through the kernel Duck service."
              },
              {
                "group": [
                  "@duckdb/*"
                ],
                "message": "Only src/kernel/duck may import DuckDB."
              },
              {
                "group": [
                  "@ff-labs/fff-node",
                  "effect/process",
                  "effect/process/**",
                  "effect/unstable/process",
                  "effect/unstable/process/**"
                ],
                "message": "Only src/kernel/search may spawn processes or import the fff search engine."
              },
              {
                "regex": "(^|/)serve(/|$)",
                "message": "src/sources slices must not import src/serve."
              },
              {
                "regex": "(^|/)infra(/|$)",
                "message": "src/sources slices must not import infra."
              },
              {
                "regex": "^\\.\\./[^./][^/]*(/|$)",
                "message": "A source slice must not import another slice; share through src/kernel."
              },
              {
                "regex": "(^|/)sources/",
                "message": "A source slice must not import another slice; share through src/kernel."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/index.ts"
      ],
      "rules": {
        "dados-publicos/no-unowned-effect-run": "off",
        "dados-publicos/no-extra-managed-runtime": "off",
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "**/src/runtime.ts"
      ],
      "rules": {
        "dados-publicos/no-unowned-effect-run": "off",
        "dados-publicos/no-extra-managed-runtime": [
          "error",
          {
            "max": 1
          }
        ]
      }
    },
    {
      "files": [
        "**/infra/**/*.run.ts"
      ],
      "rules": {
        "dados-publicos/no-unowned-effect-run": "off",
        "dados-publicos/no-extra-managed-runtime": "off"
      }
    },
    {
      "files": [
        "**/infra/**/*.ts"
      ],
      "rules": {
        "dados-publicos/no-process-env-in-alchemy-run": "error"
      }
    },
    {
      "files": [
        "**/infra/alchemy.run.ts",
        "**/infra/**/*.run.ts"
      ],
      "rules": {
        "dados-publicos/no-yield-resource-constructor": "error",
        "dados-publicos/no-stack-as-void": "error"
      }
    },
    {
      "files": [
