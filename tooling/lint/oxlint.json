                  "node:sqlite",
                  "bun:sqlite",
                  "drizzle-orm/pglite",
                  "drizzle-orm/node-postgres",
                  "drizzle-orm/postgres-js",
                  "drizzle-orm/better-sqlite3",
                  "drizzle-orm/libsql",
                  "drizzle-orm/libsql/**",
                  "drizzle-orm/bun-sqlite",
                  "drizzle-orm/bun-sql",
                  "drizzle-orm/sql-js",
                  "drizzle-orm/effect-*",
                  "@electric-sql/*",
                  "@effect/sql-*",
                  "effect/sql",
                  "effect/sql/**",
                  "effect/unstable/sql",
                  "effect/unstable/sql/**"
                ],
                "message": "No SQL drivers: tabular data goes through the kernel Duck service."
              },
              {
                "group": [
                  "@ff-labs/fff-node",
                  "effect/process",
                  "effect/process/**",
                  "effect/unstable/process",
                  "effect/unstable/process/**"
                ],
                "message": "Only src/kernel/search may spawn processes or import the fff search engine."
              },
              {
                "regex": "(^|/)(sources|serve)(/|$)",
                "message": "src/kernel is the toolbox: it must not import src/sources or src/serve."
              },
              {
                "regex": "(^|/)infra(/|$)",
                "message": "src/kernel must not import infra."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "**/src/kernel/search/**/*.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "effect/http",
                  "effect/http/**",
                  "effect/unstable/http",
                  "effect/unstable/http/**",
                  "**/HttpClient",
                  "**/FetchHttpClient"
                ],
                "message": "Only src/kernel/http may touch HTTP clients; go through the kernel Http service."
              },
              {
                "group": [
                  "drizzle-orm",
                  "drizzle-orm/**",
                  "node:sqlite",
                  "bun:sqlite",
                  "drizzle-orm/pglite",
                  "drizzle-orm/node-postgres",
                  "drizzle-orm/postgres-js",
                  "drizzle-orm/better-sqlite3",
                  "drizzle-orm/libsql",
                  "drizzle-orm/libsql/**",
                  "drizzle-orm/bun-sqlite",
                  "drizzle-orm/bun-sql",
                  "drizzle-orm/sql-js",
                  "drizzle-orm/effect-*",
                  "@electric-sql/*",
                  "@effect/sql-*",
                  "effect/sql",
                  "effect/sql/**",
                  "effect/unstable/sql",
                  "effect/unstable/sql/**"
                ],
                "message": "No SQL drivers: tabular data goes through the kernel Duck service."
              },
              {
                "group": [
