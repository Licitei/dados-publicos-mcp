        "dados-publicos/no-manual-effect-runtime-in-tests": "error",
        "dados-publicos/no-module-mocking": "error",
        "dados-publicos/no-tautological-assertion": "error",
        "eslint/no-await-in-loop": "off",
        "typescript/no-non-null-assertion": "off",
        "no-restricted-imports": [
          "error",
          {
            "patterns": []
          }
        ],
        "vitest/no-standalone-expect": "off"
      }
    },
    {
      "files": [
        "**/tooling/**/*.ts",
        "plugin/**/*.ts",
        "__tests__/**/*.ts",
        "../bench/**/*.ts",
